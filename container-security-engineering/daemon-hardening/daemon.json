{
  "userns-remap": "dockremap:dockremap",
  "icc": false,
  "no-new-privileges": true,
  "seccomp-profile": "/etc/docker/seccomp/hardened-default.json",
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  },
  "default-ulimits": {
    "nofile": {
      "Name": "nofile",
      "Soft": 64000,
      "Hard": 64000
    }
  }
}
