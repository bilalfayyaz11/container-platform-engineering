FROM python:3.13-alpine

LABEL org.opencontainers.image.title="Container Security Runtime"
LABEL org.opencontainers.image.description="Non-root runtime protected by Docker user namespace remapping"

RUN addgroup \
      --system \
      --gid 10001 \
      appgroup \
    && adduser \
      --system \
      --uid 10001 \
      --ingroup appgroup \
      --home /home/appuser \
      appuser

WORKDIR /app

COPY --chown=appuser:appgroup server.py /app/server.py

USER 10001:10001

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/ || exit 1

CMD ["python", "/app/server.py"]
