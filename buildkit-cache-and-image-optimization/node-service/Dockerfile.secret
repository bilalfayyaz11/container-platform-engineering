# syntax=docker/dockerfile:1.12

FROM node:24-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./

RUN --mount=type=cache,id=node-secret-npm-cache,target=/root/.npm,sharing=locked \
    npm ci --omit=dev

RUN --mount=type=secret,id=private_build_token,required=true \
    TOKEN="$(cat /run/secrets/private_build_token)" && \
    test -n "$TOKEN" && \
    printf 'secret_length=%s\n' "${#TOKEN}" > /tmp/build-secret-proof.txt && \
    printf 'secret_used=true\n' >> /tmp/build-secret-proof.txt

COPY server.js ./

FROM node:24-alpine AS runtime

ENV NODE_ENV=production
ENV PORT=3000

WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./
COPY --from=build /app/package-lock.json ./
COPY --from=build /app/server.js ./

RUN chown -R node:node /app

USER node

EXPOSE 3000

CMD ["npm", "start"]
